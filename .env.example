# Copy to .env, set permissions to 600, and edit locally.
# Never commit an actual API key or enable shell tracing when loading this file.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=replace_with_your_own_key
# Bootstrap alias only. Select and freeze a verified model ID for experiments.
SOCLAAS_MODEL=default
